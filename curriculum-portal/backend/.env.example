PORT=4000

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/curriculum_portal

# URL of the nlp-engine FastAPI service
NLP_ENGINE_URL=http://localhost:8000

# JWT signing secret — set a long random value in real environments
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# When true (default), POST /api/upload uses mock analysis data instead of
# calling the nlp-engine. Set to false once the real NLP service integration
# in services/analyzeSubmission.js is ready to use.
USE_MOCK_ANALYSIS=true
