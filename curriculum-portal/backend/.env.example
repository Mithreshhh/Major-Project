PORT=4000

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/curriculum_portal

# URL of the nlp-engine FastAPI service. POST /api/upload sends every uploaded
# syllabus to ${NLP_ENGINE_URL}/analyze for real skill extraction and matching.
NLP_ENGINE_URL=http://localhost:8000

# How long to wait for /analyze before giving up (504 to the client). A cold
# nlp-engine loads spaCy + Sentence-BERT first, so keep this generous.
NLP_ANALYZE_TIMEOUT_MS=120000

# How long to wait for the nlp-engine's /health probe. Runs before each upload,
# so keep it short — this is the delay before a user learns the service is down.
NLP_HEALTH_TIMEOUT_MS=3000

# How long a health result may be reused before re-probing.
NLP_HEALTH_CACHE_MS=5000

# When true (default), POST /api/upload checks the nlp-engine is up and ready
# before accepting a file, failing fast with 503 instead of after a full upload.
# Set false to skip the pre-flight check and let the analyze call surface it.
REQUIRE_NLP_READY=true

# JWT signing secret — set a long random value in real environments
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
