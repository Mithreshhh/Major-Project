POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=curriculum_portal
POSTGRES_HOST=localhost
# All three services must point at the SAME Postgres. If you run it in Docker
# on a non-default port (see the Windows port-conflict note in RUN.md step 1),
# change it here AND in backend/.env and nlp-engine/.env - a mismatch shows up
# as the nlp-engine reporting "database: error" while the backend works fine.
POSTGRES_PORT=5432

# Alternatively set DATABASE_URL and it takes precedence over the POSTGRES_*
# values above, matching what backend/.env and nlp-engine/.env use.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/curriculum_portal
